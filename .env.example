# コピーして .env を作る（.env はコミットしない）。ここにはダミー値だけを書くこと。

# --- DB ---
# Docker Compose の app コンテナでは compose.yaml 側で db ホストに上書きされる
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rise_knowledge_dev"

# --- 認証（Auth.js） ---
# 生成: openssl rand -base64 32
AUTH_SECRET="change-me"
# 本番の URL（例: https://knowledge.example.co.jp）。開発では不要
# AUTH_URL=""

# 使う SSO: google | microsoft-entra-id
AUTH_PROVIDER="google"
# ログインを許可するメールのドメイン（カンマ区切り、完全一致）
AUTH_ALLOWED_DOMAINS="example.co.jp"

# Google Workspace（AUTH_PROVIDER=google のとき）
# リダイレクト URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID（AUTH_PROVIDER=microsoft-entra-id のとき）
# リダイレクト URI: {AUTH_URL}/api/auth/callback/microsoft-entra-id
# ISSUER は自社テナント ID を含めること（common は不可）
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# 開発・E2E 用のログイン（SSO なしでログインできる）。本番で true にすると起動しない
AUTH_DEV_LOGIN="false"

# --- 画像の保存先 ---
# local = ディスク（ローカル開発・テストのみ。本番では起動しない）、s3 = S3 互換ストレージ（本番・MinIO）
STORAGE_DRIVER="local"
# STORAGE_DRIVER=local のときの保存先ディレクトリ（コミットしない）
STORAGE_LOCAL_DIR=".data/uploads"
# STORAGE_DRIVER=s3 のとき。MinIO を使う場合は S3_ENDPOINT と S3_FORCE_PATH_STYLE="true" を指定する
# S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
